# Copy to .env and fill in. Docker Compose reads .env for local development; in
# production (PythonAnywhere) pa_wsgi.py loads ~/torqued/.env.

# ── Database ──────────────────────────────────────────────────────────────────
# The app uses SQLite by default (an on-disk file at data/garage.db) — no config
# needed for local dev, tests, or production. To use PostgreSQL instead, set a full
# SQLAlchemy URL; the psycopg v3 driver is pinned automatically and ?sslmode=… is
# honoured (a bare postgres:// URL is accepted verbatim), e.g.
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/torqued

# Optional: point the CLI at another database with `make … prod=1` (e.g. to run
# migrations or user commands against a remote environment).
#   PROD_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/torqued

# Flask session signing key — REQUIRED in production (FLASK_DEBUG=0).
SECRET_KEY=change-me

# ── Self-redeploy webhook (optional) ──────────────────────────────────────────
# Lets the CI deploy job trigger a redeploy over HTTP (POST /api/deploy/webhook),
# authenticated by an HMAC-SHA256 signature. Set BOTH on PythonAnywhere to enable it;
# omitting either keeps the endpoint a 404. Use a dedicated random secret — NOT SECRET_KEY
# (sharing the cookie-signing key with CI would widen its blast radius). Put the same
# secret, plus DEPLOY_WEBHOOK_URL=https://USER.pythonanywhere.com/api/deploy/webhook, in
# the GitHub repo secrets.
#   ENABLE_DEPLOY_WEBHOOK=1
#   DEPLOY_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── DVSA MOT History API (optional) ───────────────────────────────────────────
MOT_CLIENT_ID=
MOT_CLIENT_SECRET=
MOT_TOKEN_URL=
MOT_API_KEY=

# ── DVLA VES lookup (gov.uk vehicle enquiry service) ──────────────────────────
# Needs no credentials — Torqued scrapes the public "Check if a vehicle is taxed"
# service for the full VES snapshot (tax + MOT status + vehicle profile). Set to 0 to
# disable the lookup (e.g. if outbound access is blocked).
VES_SCRAPE_ENABLED=1

# Optional relay for hosts whose outbound whitelist blocks the enquiry service. On a free
# PythonAnywhere account, egress only reaches whitelisted hosts — vehicleenquiry.service.gov.uk
# is NOT one (a VES refresh fails with "Tunnel connection failed: 403 Forbidden") but *.workers.dev
# IS. Point VES_RELAY_URL at the Cloudflare Worker in relay/ves-worker/ (which does the scrape,
# e.g. https://torqued-ves.<subdomain>.workers.dev) and it proxies through instead of hitting
# gov.uk directly; VES_RELAY_TOKEN must match the Worker's RELAY_TOKEN secret. Leave unset
# locally. See docs/VES_API.md.
VES_RELAY_URL=
VES_RELAY_TOKEN=

# ── PythonAnywhere admin stats (optional) ─────────────────────────────────────
PA_API_TOKEN=
PA_USERNAME=

# ── PostHog server-side analytics (optional) ──────────────────────────────────
# Sends product events (login, vehicle/service created) to PostHog. Absent the
# key the backend never calls PostHog. This is the project (write) key — the same
# public key the frontend ships. POSTHOG_HOST defaults to the US region.
POSTHOG_API_KEY=phc_m6UAiEkP3t6tavwv8U8akS7rPmzdE3xyN9SSwwEnSxiz
POSTHOG_HOST=https://us.i.posthog.com
