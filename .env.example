# Copy to .env and fill in. Docker Compose reads .env for local development; in
# production (PythonAnywhere) pa_wsgi.py loads ~/torqued/.env.

# ── Database ──────────────────────────────────────────────────────────────────
# Full SQLAlchemy URL. PostgreSQL in dev/prod (the psycopg v3 driver).
#
# Local dev with `make run` does NOT need this set here — compose.yml points the
# backend at its bundled `db` service automatically. Set it for production:
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/torqued

# A hosted-Postgres URL (Neon, Supabase, Railway, …) can be pasted verbatim: the
# psycopg v3 driver is pinned automatically and ?sslmode=require is honoured, e.g.
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Dev-only login database switcher. When running in development (FLASK_DEBUG=1, e.g.
# `make run`) AND this is set, the login page offers a "Production" option that points
# the app at this database for that session. Ignored entirely in a real deployment.
#   PROD_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Flask session signing key — REQUIRED in production (FLASK_DEBUG=0).
SECRET_KEY=change-me

# ── DVSA MOT History API (optional) ───────────────────────────────────────────
MOT_CLIENT_ID=
MOT_CLIENT_SECRET=
MOT_TOKEN_URL=
MOT_API_KEY=

# ── PythonAnywhere admin stats (optional) ─────────────────────────────────────
PA_API_TOKEN=
PA_USERNAME=
