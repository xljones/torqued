# Copy to .env and fill in. Docker Compose reads .env for local development; in
# production (PythonAnywhere) pa_wsgi.py loads ~/torqued/.env.

# ── Database ──────────────────────────────────────────────────────────────────
# Full SQLAlchemy URL. PostgreSQL in dev/prod (the psycopg v3 driver).
#
# Local dev with `make run` does NOT need this set here — compose.yml points the
# backend at its bundled `db` service automatically. Set it for production:
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/torqued

# A hosted-Postgres URL (Neon, Supabase, Railway, …) can be pasted verbatim: the
# psycopg v3 driver is pinned automatically and ?sslmode=require is honoured, e.g.
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Dev-only login database switcher. Set ENABLE_DB_SWITCHER=1 AND PROD_DATABASE_URL and
# the login page offers a "Production" option that points the app at that database for the
# session. `make run` (compose.yml) sets ENABLE_DB_SWITCHER for you. Production never sets
# it, so the switch is inert there regardless of FLASK_DEBUG.
#   ENABLE_DB_SWITCHER=1
#   PROD_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Flask session signing key — REQUIRED in production (FLASK_DEBUG=0).
SECRET_KEY=change-me

# ── Self-redeploy webhook (optional) ──────────────────────────────────────────
# Lets the CI deploy job trigger a redeploy over HTTP (POST /api/deploy/webhook),
# authenticated by an HMAC-SHA256 signature. Set BOTH on PythonAnywhere to enable it;
# omitting either keeps the endpoint a 404. Use a dedicated random secret — NOT SECRET_KEY
# (sharing the cookie-signing key with CI would widen its blast radius). Put the same
# secret, plus DEPLOY_WEBHOOK_URL=https://USER.pythonanywhere.com/api/deploy/webhook, in
# the GitHub repo secrets.
#   ENABLE_DEPLOY_WEBHOOK=1
#   DEPLOY_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── DVSA MOT History API (optional) ───────────────────────────────────────────
MOT_CLIENT_ID=
MOT_CLIENT_SECRET=
MOT_TOKEN_URL=
MOT_API_KEY=

# ── PythonAnywhere admin stats (optional) ─────────────────────────────────────
PA_API_TOKEN=
PA_USERNAME=

# ── Neon database stats (optional) ────────────────────────────────────────────
# Admin panel "Neon database" card (storage / compute usage). NEON_API_KEY is a
# Neon API key (console.neon.tech → Account settings → API keys). NEON_PROJECT_ID
# is optional — when omitted the first project on the key is used.
NEON_API_KEY=
NEON_PROJECT_ID=
# Denominator for the compute % bar, in compute-hours. Storage uses Neon's reported
# size limit automatically, but compute has no plan-inherent limit — set your monthly
# compute-hours allowance here (Free ≈ 100). Falls back to any Neon consumption limit
# you've configured, else the card shows a plain compute-hours figure.
NEON_COMPUTE_LIMIT_HOURS=
